<Window x:Class="ContextSlicer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContextSlicer"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}" Height="450" Width="780"
        MinWidth="780" MinHeight="450"
         WindowStartupLocation="CenterScreen"
         Closing="Window_Closing"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подгружаем дефолтный словарь, чтобы дизайнер Студии сразу видел все надписи -->
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 1. Текстовые блоки (метки) -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 2. Стилизация рамок GroupBox -->
            <Style TargetType="GroupBox">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{DynamicResource ControlBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5">
                                <Grid Background="{DynamicResource ControlBackgroundBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,0,0,4" Margin="0,0,0,5">
                                        <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold"/>
                                    </Border>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. Чекбоксы и Радиокнопки -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,15,0"/>
            </Style>

            <!-- 4. Текстовые поля ввода -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 5. Дерево файлов (TreeView) -->
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 6. Мелкие серые кнопки управления -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="Height" Value="24"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Главный контейнер формы с принудительной динамической кистью фона -->
    <!-- Главный контейнер формы -->
    <Grid Margin="10" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. УПРАВЛЕНИЕ ПРОЕКТОМ (Expander с мультиязычным заголовком) -->
        <Expander Grid.Row="0" ExpandDirection="Down" Margin="0,0,0,10"
                  IsExpanded="{Binding IsProjectBlockExpanded}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <!-- Основное название блока -->
                    <TextBlock Text="{DynamicResource Str_ProjManagement}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text=": " FontWeight="Bold" FontSize="12"/>

                    <!-- Чистая и безопасная строка статуса проекта без наложений -->
                    <TextBlock Text="{Binding DisplayProjectName}" FontWeight="Bold" FontSize="12" Foreground="#007ACC"/>
                </StackPanel>
            </Expander.Header>


            <Grid Margin="0,5,0,0" Background="{DynamicResource ControlBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,4,15,4">
                        <TextBlock Text="{DynamicResource Str_SelectProj}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                        <ComboBox ItemsSource="{Binding Projects}" 
                                  SelectedItem="{Binding SelectedProject}" 
                                  DisplayMemberPath="ProjectName" 
                                  Width="200" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,15,4">
                        <TextBlock Text="{DynamicResource Str_ProjName}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding ProjectNameInput, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Content="{DynamicResource Str_CreateProj}" Command="{Binding CreateNewProjectCommand}" Margin="0,4,15,4" Height="26"/>
                    <CheckBox IsChecked="{Binding IsAutoSaveEnabled}" Content="{DynamicResource Str_Autosave}" Margin="0,4,15,4"/>
                    <CheckBox IsChecked="{Binding IsDarkTheme}" Content="{DynamicResource Str_DarkTheme}" Margin="10,4,15,4"/>
                </WrapPanel>

                <!-- Пути к папкам проекта -->
                <Grid Grid.Row="1" Margin="5,0,5,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_RootPath}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <Button Grid.Column="2" Content="{DynamicResource Str_Browse}" Command="{Binding BrowseRootPathCommand}" Width="75" Margin="5,0,0,0"/>
                </Grid>

                <Grid Grid.Row="2" Margin="5,0,5,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_OutputPath}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <Button Grid.Column="2" Content="{DynamicResource Str_Browse}" Command="{Binding BrowseOutputPathCommand}" Width="75" Margin="5,0,0,0"/>
                </Grid>
            </Grid>
        </Expander>
        <!-- 2. БЛОК УПРАВЛЕНИЯ МОДУЛЯМИ -->
        <GroupBox Header="{DynamicResource Str_ModuleManagement}" Grid.Row="1" Margin="0,0,0,15" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{DynamicResource Str_SelectModule}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Modules}" 
                              SelectedItem="{Binding SelectedModule}" 
                              DisplayMemberPath="ModuleName" 
                              Width="200" Height="26" VerticalContentAlignment="Center"
                              IsEnabled="{Binding IsModuleSelectorEnabled}"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Str_ModuleName}" VerticalAlignment="Center" Width="110"/>
                        <TextBox Text="{Binding ModuleNameInput, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="24" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,2,0,0">
                        <TextBlock Text="{DynamicResource Str_FileFormat}" VerticalAlignment="Center" Width="110" FontWeight="SemiBold"/>
                        <RadioButton Content="txt" IsChecked="{Binding IsPdfFormat, Converter={x:Static local:InverseBooleanConverter.Instance}, Mode=TwoWay}" Margin="0,0,20,0"/>
                        <RadioButton Content="pdf" IsChecked="{Binding IsPdfFormat}" />
                    </StackPanel>
                </Grid>

                <Button Content="{DynamicResource Str_AddModule}" Command="{Binding CreateNewModuleCommand}" Grid.Column="2" Padding="15,0" Height="26" VerticalAlignment="Top" Margin="0,1,5,0"/>
            </Grid>
        </GroupBox>

        <!-- 3. БЛОК РАБОЧЕЙ ОБЛАСТИ (ДЕРЕВО И ПРАВИЛА) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="{DynamicResource Str_FilesHeader}" Grid.Column="0" Margin="0,0,5,0">
                <TreeView ItemsSource="{Binding RootNode.Children}">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:FileSystemNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>

            <GroupBox Header="{DynamicResource Str_PromptHeader}" Grid.Column="2" Margin="5,0,0,0">
                <TextBox Text="{Binding PromptRules, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
            </GroupBox>
        </Grid>

        <!-- 4. БЛОК НИЖНИХ КНОПОК -->
        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Button Content="{DynamicResource Str_SaveProject}" Command="{Binding SaveProjectCommand}" Grid.Column="0" Height="48" Margin="0,0,5,0" Style="{x:Null}" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="13"/>
            <Button Content="{DynamicResource Str_Generate}" Command="{Binding GenerateContextCommand}" Grid.Column="1" Height="48" Margin="5,0,0,0" Style="{x:Null}" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="13"/>
        </Grid>

        <!-- ОВЕРЛЕЙ ПРОГРЕССА -->
        <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="ProgressOverlay"
              Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#A0000000"/>
            <Border Width="500" Height="180" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource ControlBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding ProgressText}" Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding CurrentFileText}" Grid.Row="1" FontSize="11" Margin="0,0,0,15" Foreground="#A0A0A0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <ProgressBar Grid.Row="2" Height="16" VerticalAlignment="Top"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Background="{DynamicResource TextBoxBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                    <Button Content="{DynamicResource Str_Cancel}" Grid.Row="3"
                            Command="{Binding CancelGenerationCommand}" Height="32" Width="180" Style="{x:Null}"
                            Background="#D32F2F" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



