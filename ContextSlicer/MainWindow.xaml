<Window x:Class="ContextSlicer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContextSlicer"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}" Height="450" Width="780"
        MinWidth="780" MinHeight="450"
         WindowStartupLocation="CenterScreen"
         Closing="Window_Closing"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/ContentSlicer.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подгружаем дефолтный словарь, чтобы дизайнер Студии сразу видел все надписи -->
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 1. Текстовые блоки (метки) -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 2. Стилизация рамок GroupBox -->
            <Style TargetType="GroupBox">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{DynamicResource ControlBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5">
                                <Grid Background="{DynamicResource ControlBackgroundBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,0,0,4" Margin="0,0,0,5">
                                        <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold"/>
                                    </Border>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. Чекбоксы и Радиокнопки -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,15,0"/>
            </Style>

            <!-- 4. Текстовые поля ввода -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 5. Дерево файлов (TreeView) -->
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- ЕДИНСТВЕННЫЙ И ИСПРАВЛЕННЫЙ СТИЛЬ ДЛЯ ВСЕХ КНОПОК ФОРМЫ -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Основной контейнер кнопки берет фон напрямую из свойства Background самого элемента -->
                            <Border x:Name="mainBorder" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid>
                                    <!-- Скрытый слой затемнения/высветления для реализации красивого эффекта Hover -->
                                    <Border x:Name="hoverOverlay" Background="Transparent" CornerRadius="2"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- ЭФФЕКТ НАВЕДЕНИЯ МЫШИ (ИСПРАВЛЕНО: работает универсально для всех типов кнопок) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="mainBorder" Property="BorderBrush" Value="#007ACC"/>
                                    <!-- Полупрозрачный белый слой делает кнопку мягко светлее при наведении (отлично для темной темы) -->
                                    <Setter TargetName="hoverOverlay" Property="Background" Value="#15FFFFFF"/>
                                </Trigger>
                                <!-- ЭФФЕКТ НАЖАТИЯ (КЛИКА) -->
                                <Trigger Property="IsPressed" Value="True">
                                    <!-- Мягкое затемнение при клике -->
                                    <Setter TargetName="hoverOverlay" Property="Background" Value="#30000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ИСПРАВЛЕНО: Безопасный стиль выделения строк дерева без конфликтов типов данных -->
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Style.Resources>
                    <!-- Полностью обнуляем дефолтные системные системные цвета выделения Windows Aero, -->
                    <!-- чтобы они не окрашивали ноду в ядовито-синий или черный цвет при фокусе -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </Style.Resources>

                <Style.Triggers>
                    <!-- Перекрашиваем текст ноды в красивый акцентный синий цвет при её выделении -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#007ACC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


            <!-- ИСПРАВЛЕНО: Полное и бескомпромиссное уничтожение плейсхолдера иконок в ContextMenu -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>

            </Style>
            <!-- ИСПРАВЛЕНО: Бескомпромиссное уничтожение плейсхолдера иконок через переопределение шаблона -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <!-- Мы полностью выкинули системную таблицу с колонкой для иконок -->
                            <Border x:Name="idxBorder" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="15,6">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Красивый Hover-эффект для пункта тёмного меню -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="idxBorder" Property="Background" Value="#3E3E42"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- ИЗОЛИРОВАННЫЙ И УНИВЕРСАЛЬНЫЙ СТИЛЬ ДЛЯ COMBOBOX -->
            <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="MainBorder" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ИСПРАВЛЕНО: Добавлена жесткая привязка к SelectionBoxItemTemplate для защиты от вывода имени класса C# -->
                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                  Content="{TemplateBinding SelectionBoxItem}"
                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                  TextBlock.Foreground="{DynamicResource TextBrush}"
                  Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    <ToggleButton Grid.Column="1" Focusable="False" Background="Transparent" BorderBrush="Transparent"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" 
                                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource ControlBackgroundBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Style.Resources>
            </Style>

        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: Вертикальный Экспандер с ListBox проектов -->
            <ColumnDefinition Width="Auto"/>
            <!-- Правая колонка: Вся основная рабочая область приложения -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- 1. СВОРАЧИВАЕМЫЙ ВЕРТИКАЛЬНЫЙ SIDEBAR (СПИСОК ПРОЕКТОВ)           -->
        <!-- ================================================================= -->
        <Expander Grid.Column="0" IsExpanded="True" ExpandDirection="Right" 
              Background="{DynamicResource PanelBackgroundBrush}" 
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Expander.Header>
                <TextBlock Text="ПРОЕКТЫ" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="11">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Expander.Header>

            <Grid Width="220" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ListBox проектов с динамическими иконками и текстом -->
                <ListBox Grid.Row="0" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                     Background="{DynamicResource InputBackgroundBrush}" 
                     BorderBrush="{DynamicResource BorderBrush}" 
                     Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding ProjectTypeIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProjectName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ИСПРАВЛЕННАЯ КНОПКА СОЗДАНИЯ ПРОЕКТА: В стиле кнопок редактирования! -->
                <!-- Она прозрачная, с легкой рамкой и ярким синим плюсом, видимым везде -->
                <Button Grid.Row="1" Content="+" ToolTip="Создать новый проект"
                    Command="{Binding CreateNewProjectConfigCommand}"
                    Height="26" FontWeight="Bold" FontSize="18" Padding="0,0,0,3"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                    >
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Expander>
        <!-- ================================================================= -->
        <!-- ЧАСТЬ 2.2.1: ОСНОВНАЯ СЕТКА И ДВУХСТРОЧНАЯ ВЕРХНЯЯ ПАНЕЛЬ         -->
        <!-- ================================================================= -->
        <!-- ================================================================= -->
        <!-- ПОЛНАЯ И ИСПРАВЛЕННАЯ РАБОЧАЯ ОБЛАСТЬ (ВЕРХ, ДЕРЕВО, ПРАВИЛА, ПОДВАЛ) -->
        <!-- ================================================================= -->
        <Grid Grid.Column="1" Margin="10,10,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Строка 0: Верхняя панель -->
                <RowDefinition Height="*"/>
                <!-- Строка 1: Дерево и правила -->
                <RowDefinition Height="Auto"/>
                <!-- Строка 2: Техническая панель -->
                <RowDefinition Height="Auto"/>
                <!-- Строка 3: Подвал -->
            </Grid.RowDefinitions>

            <!-- ВЕРХНЯЯ ПАНЕЛЬ КОНТЕКСТА -->
            <GroupBox Grid.Row="0" Header="{DynamicResource Str_ModuleManagement}" Margin="0,0,0,10" Padding="8"
                  Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="34"/>
                    </Grid.RowDefinitions>

                    <!-- СТРОКА 0: УПРАВЛЕНИЕ ПРОЕКТОМ -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding SelectedProject.ProjectName, FallbackValue='Проект не выбран'}" 
                               Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,12,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE70F;" ToolTip="{DynamicResource Str_TooltipProjectEdit}" Command="{Binding ShowProjectSettingsCommand}"
                                FontFamily="Segoe MDL2 Assets" FontSize="13" Width="28" Height="28" Padding="0" 
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button Content="&#xE72C;" ToolTip="{DynamicResource Str_TooltipProjectSync}" Command="{Binding SyncProjectSourceCommand}"
                                FontFamily="Segoe MDL2 Assets" FontSize="13" Width="28" Height="28" Margin="5,0,0,0" Padding="0" 
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                            <CheckBox Content="{DynamicResource Str_IncludeStructure}" IsChecked="{Binding IncludeDirectoryStructure}" 
                                  Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                            <CheckBox Content="{DynamicResource Str_Autosave}" IsChecked="{Binding IsAutoSaveEnabled}" 
                                  Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- СТРОКА 1: УПРАВЛЕНИЕ МОДУЛЯМИ -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_SelectModule}" Foreground="{DynamicResource TextBrush}" 
                               VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="SemiBold" FontSize="13"/>
                        <!-- Полностью очищенный от локальных стилей ComboBox модулей -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
          DisplayMemberPath="ModuleName" Height="26" VerticalContentAlignment="Center" Margin="0,0,10,0"
          Style="{DynamicResource ThemeComboBoxStyle}"/>
                        <TextBox Grid.Column="2" Text="{Binding NewModuleNameInput, UpdateSourceTrigger=PropertyChanged}" 
                             Height="26" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="5,0"
                             Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBrush}" 
                             BorderBrush="{DynamicResource BorderBrush}"/>

                        <Button Grid.Column="3" Content="+" ToolTip="{DynamicResource Str_TooltipModuleAdd}" Command="{Binding CreateNewModuleCommand}"
                            Width="28" Height="26" FontWeight="Bold" FontSize="16" Padding="0,0,0,2" 
                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource AccentBrush}"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="4" Content="&#xE70F;" ToolTip="{DynamicResource Str_TooltipModuleEdit}" Command="{Binding ShowEditOverlayCommand}"
                            FontFamily="Segoe MDL2 Assets" FontSize="11" Width="28" Height="26" Margin="5,0,0,0" Padding="0" 
                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="{Binding IsModuleSelectorEnabled}"/>

                        <Button Grid.Column="5" Content="&#xE74D;" ToolTip="{DynamicResource Str_TooltipModuleDelete}" Command="{Binding DeleteCurrentModuleCommand}"
                            FontFamily="Segoe MDL2 Assets" FontSize="12" Width="28" Height="26" Margin="5,0,5,0" Padding="0" 
                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="{Binding IsModuleSelectorEnabled}"/>
                    </Grid>
                </Grid>
            </GroupBox>
            <!-- ================================================================= -->
            <!-- ЧАСТЬ 2.2.2: ЦЕНТРАЛЬНАЯ РАБОЧАЯ ЗОНА (ВОЗВРАТ ДЕРЕВА И ПРАВИЛ)   -->
            <!-- ================================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <!-- Левая часть: Универсальное дерево TreeView -->
                    <ColumnDefinition Width="280"/>
                    <!-- Разделитель колонок (GridSplitter) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Правая часть: Два больших поля правил -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Наше синтаксическое/литературное дерево файлов -->
                <TreeView Grid.Column="0" ItemsSource="{Binding RootNode.Children}" TreeViewItem.Expanded="TreeView_Expanded"
                      Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <!-- Шаблон иерархии (наш рабочий плоский вариант из прошлой задачи) -->
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:FileSystemNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TypePrefixText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- Вертикальный разделитель колонок -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- Зона правил (Два больших текстовых поля) -->
                <Grid Grid.Column="2" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- Глобальные правила проекта -->
                        <RowDefinition Height="Auto"/>
                        <!-- Сплиттер строк -->
                        <RowDefinition Height="*"/>
                        <!-- Специфичные правила модуля -->
                    </Grid.RowDefinitions>

                    <!-- Глобальные правила -->
                    <GroupBox Grid.Row="0" Header="{DynamicResource Str_PromptHeader}" Padding="2"
                          Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBox Text="{Binding PromptRules, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBrush}" 
                             BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>

                    <!-- Горизонтальный разделитель строк -->
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                    <!-- Инструкции модуля -->
                    <GroupBox Grid.Row="2" Header="{DynamicResource Str_ModulePromptHeader}" Padding="2"
                          Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBox Text="{Binding ModuleRules, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBrush}" 
                             BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </Grid>
            <!-- ================================================================= -->
            <!-- ЧАСТЬ 2.2.3: ТЕХНИЧЕСКАЯ ПАНЕЛЬ И ПОДВАЛ (ФИНАЛ СЕТКИ ОКНА)       -->
            <!-- ================================================================= -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Радиокнопки форматов -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Кнопка "Фильтры" -->
                    <ColumnDefinition Width="*"/>
                    <!-- Разделитель и статистика -->
                </Grid.ColumnDefinitions>

                <!-- Переключатели формата итогового файла -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <RadioButton Content="TXT" IsChecked="{Binding IsTxtFormat}" Foreground="{DynamicResource TextBrush}" Margin="0,0,12,0"/>
                    <RadioButton Content="PDF" IsChecked="{Binding IsPdfFormat}" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>

                <!-- Кнопка вызова фильтров масок-исключений (Переведена на ресурсы) -->
                <Button Grid.Column="1" Content="{DynamicResource Str_GlobalFilters}" Command="{Binding ShowFiltersCommand}"
                    Padding="10,2" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Панель статистики (Крупные контрастные цифры, меняющие цвет с темой) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="15,0"/>

                    <TextBlock Text="{DynamicResource Str_StatsChars}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalCharacters, FallbackValue=0}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,20,0"/>

                    <TextBlock Text="{DynamicResource Str_StatsTokens}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalTokens, FallbackValue=0}" Foreground="#4CAF50" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- САМЫЙ ПОДВАЛ ОКНА -->
            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Кнопка Сохранить -->
                    <ColumnDefinition Width="*"/>
                    <!-- Кнопка Генерировать -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Чекбокс Темы -->
                </Grid.ColumnDefinitions>

                <!-- Кнопка ручного сохранения проекта -->
                <Button Grid.Column="0" Content="{DynamicResource Str_SaveProject}" Command="{Binding SaveProjectCommand}"
                    Width="170" Height="30" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Кнопка генерации контекста в легком прозрачном стиле с рамкой -->
                <Button Grid.Column="1" Content="{DynamicResource Str_Generate}" Command="{Binding GenerateContextCommand}"
                    Height="30" Margin="10,0" FontWeight="Bold" FontSize="13"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Переключатель темного/светлого оформления -->
                <CheckBox Grid.Column="2" Content="{DynamicResource Str_DarkTheme}" IsChecked="{Binding IsDarkTheme}" 
                      Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <!-- ================================================================= -->
        <!-- ОБНОВЛЕННЫЙ ОВЕРЛЕЙ ПРОЕКТОВ С ВНУТРЕННЕЙ КНОПКОЙ И ВАЛИДАЦИЕЙ    -->
        <!-- ================================================================= -->
        <!-- ================================================================= -->
        <!-- ЧАСТЬ 3.1: ОБНОВЛЕННЫЙ ОВЕРЛЕЙ ПРОЕКТОВ (СЕТКА ПОЛЕЙ ВВОДА)      -->
        <!-- ================================================================= -->
        <Grid Visibility="{Binding IsProjectOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <!-- Блокирующий и затемняющий фон основного окна -->
            <Border Background="#A0000000"/>

            <Border Width="450" Height="290" Background="{DynamicResource PanelBackgroundBrush}" 
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="5" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="15">
                <Grid>
                    <!-- Главный контейнер полей. Блокируется целиком при загрузке (IsEnabled) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjectLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 0: Заголовок -->
                            <RowDefinition Height="*"/>
                            <!-- 1: Поля ввода -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2: Кнопки действий -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Str_ProjManagement}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Название проекта -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_ProjName}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditProjectNameInput, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                            <!-- 2. Переключатели трех типов (Folder, GoogleDoc, WordDoc) -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Папка" IsChecked="{Binding IsLocalFolderSelected}" Foreground="{DynamicResource TextBrush}"/>
                                <RadioButton Content="Google Doc" IsChecked="{Binding IsGoogleDocSelected}" Foreground="{DynamicResource TextBrush}" Margin="12,0,0,0"/>
                                <RadioButton Content="MS Word" IsChecked="{Binding IsWordDocSelected}" Foreground="{DynamicResource TextBrush}" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- 3. Источник данных -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_SourceDataLabel}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding EditProjectRootPathInput, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Padding="4,2,24,2"/>
                                    <!-- Внутренняя иконка Вставить из буфера обмена 📋 для Google Doc -->
                                    <Button Content="&#xE813;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="20" Height="20" 
                                        Command="{Binding PasteUrlFromClipboardCommand}" ToolTip="Вставить ссылку"
                                        HorizontalAlignment="Right" Margin="0,0,2,0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TextBrush}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGoogleDocSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Кнопка Обзор (Блокируется, если выбрано облако) -->
                                <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Command="{Binding BrowseProjectSourceCommand}" Width="75" Margin="5,0,0,0" Height="24">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGoogleDocSelected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- 4. Папка выгрузки -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_OutputPath}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="3" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditProjectOutputPathInput, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="{DynamicResource Str_Browse}" Command="{Binding BrowseOutputFolderCommand}" Width="75" Margin="5,0,0,0" Height="24"/>
                            </Grid>
                        </Grid>
                        <!-- ========================================================== -->
                        <!-- НИЖНИЕ КНОПКИ ДЕЙСТВИЙ (ENTER / ESC)                       -->
                        <!-- ========================================================== -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Кнопка Отмена (Esc) -->
                            <Button Content="{DynamicResource Str_BtnCancel}" Command="{Binding CancelProjectOverlayCommand}" 
                                IsCancel="True" Width="85" Height="26" Margin="0,0,8,0" Background="Transparent" Foreground="{DynamicResource TextBrush}"/>

                            <!-- Кнопка Принять (Enter) -->
                            <Button Content="{DynamicResource Str_BtnAccept}" Command="{Binding ConfirmSaveProjectConfigCommand}" 
                                IsDefault="True" Width="85" Height="26" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" 
                                Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- ========================================================== -->
                    <!-- ВНУТРЕННИЙ ВСПЛЫВАЮЩИЙ СЛОЙ ЗАГРУЗКИ / СИНХРОНИЗАЦИИ        -->
                    <!-- ========================================================== -->
                    <Grid Visibility="{Binding IsProjectLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <!-- Мягкое внутреннее затемнение оверлея под цвет текущей панели -->
                        <Border Background="{DynamicResource PanelBackgroundBrush}" Opacity="0.85" CornerRadius="4"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Бегущая полоса прогресса, адаптированная под тему -->
                            <ProgressBar IsIndeterminate="True" Width="180" Height="6" 
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBackgroundBrush}" 
                                     BorderThickness="0" Margin="0,0,0,12"/>

                            <!-- Текст текущего статуса операции -->
                            <TextBlock Text="Синхронизация структуры..." 
                                   Foreground="{DynamicResource TextBrush}" 
                                   FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


    </Grid>
    <!-- Финальное закрытие самого корневого Grid окна -->

</Window>