<Window x:Class="ContextSlicer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContextSlicer"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}" Height="450" Width="780"
        MinWidth="780" MinHeight="450"
         WindowStartupLocation="CenterScreen"
         Closing="Window_Closing"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/ContentSlicer.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подгружаем дефолтный словарь, чтобы дизайнер Студии сразу видел все надписи -->
                <ResourceDictionary Source="pack://application:,,,/Localization/Strings.ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 1. Текстовые блоки (метки) -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 2. Стилизация рамок GroupBox -->
            <Style TargetType="GroupBox">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{DynamicResource ControlBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5">
                                <Grid Background="{DynamicResource ControlBackgroundBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,0,0,4" Margin="0,0,0,5">
                                        <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold"/>
                                    </Border>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. Чекбоксы и Радиокнопки -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,15,0"/>
            </Style>

            <!-- 4. Текстовые поля ввода -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- 5. Дерево файлов (TreeView) -->
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- ЕДИНСТВЕННЫЙ И ИСПРАВЛЕННЫЙ СТИЛЬ ДЛЯ ВСЕХ КНОПОК ФОРМЫ -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Основной контейнер кнопки берет фон напрямую из свойства Background самого элемента -->
                            <Border x:Name="mainBorder" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid>
                                    <!-- Скрытый слой затемнения/высветления для реализации красивого эффекта Hover -->
                                    <Border x:Name="hoverOverlay" Background="Transparent" CornerRadius="2"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- ЭФФЕКТ НАВЕДЕНИЯ МЫШИ (ИСПРАВЛЕНО: работает универсально для всех типов кнопок) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="mainBorder" Property="BorderBrush" Value="#007ACC"/>
                                    <!-- Полупрозрачный белый слой делает кнопку мягко светлее при наведении (отлично для темной темы) -->
                                    <Setter TargetName="hoverOverlay" Property="Background" Value="#15FFFFFF"/>
                                </Trigger>
                                <!-- ЭФФЕКТ НАЖАТИЯ (КЛИКА) -->
                                <Trigger Property="IsPressed" Value="True">
                                    <!-- Мягкое затемнение при клике -->
                                    <Setter TargetName="hoverOverlay" Property="Background" Value="#30000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ИСПРАВЛЕНО: Безопасный стиль выделения строк дерева без конфликтов типов данных -->
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Style.Resources>
                    <!-- Полностью обнуляем дефолтные системные системные цвета выделения Windows Aero, -->
                    <!-- чтобы они не окрашивали ноду в ядовито-синий или черный цвет при фокусе -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </Style.Resources>

                <Style.Triggers>
                    <!-- Перекрашиваем текст ноды в красивый акцентный синий цвет при её выделении -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#007ACC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


            <!-- ИСПРАВЛЕНО: Полное и бескомпромиссное уничтожение плейсхолдера иконок в ContextMenu -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                
            </Style>
            <!-- ИСПРАВЛЕНО: Бескомпромиссное уничтожение плейсхолдера иконок через переопределение шаблона -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <!-- Мы полностью выкинули системную таблицу с колонкой для иконок -->
                            <Border x:Name="idxBorder" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="15,6">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Красивый Hover-эффект для пункта тёмного меню -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="idxBorder" Property="Background" Value="#3E3E42"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>
    <!-- Главный контейнер формы с принудительной динамической кистью фона -->
    <!-- Главный контейнер формы -->
    <Grid Margin="10" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. УПРАВЛЕНИЕ ПРОЕКТОМ (Expander с мультиязычным заголовком) -->
        <Expander Grid.Row="0" ExpandDirection="Down" Margin="0,0,0,10"
                  IsExpanded="{Binding IsProjectBlockExpanded}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <!-- Основное название блока -->
                    <TextBlock Text="{DynamicResource Str_ProjManagement}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text=": " FontWeight="Bold" FontSize="12"/>

                    <!-- Чистая и безопасная строка статуса проекта без наложений -->
                    <TextBlock Text="{Binding DisplayProjectName}" FontWeight="Bold" FontSize="12" Foreground="#007ACC"/>
                </StackPanel>
            </Expander.Header>


            <Grid Margin="0,5,0,0" Background="{DynamicResource ControlBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,4,15,4">
                        <TextBlock Text="{DynamicResource Str_SelectProj}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                        <ComboBox ItemsSource="{Binding Projects}" 
                                  SelectedItem="{Binding SelectedProject}" 
                                  DisplayMemberPath="ProjectName" 
                                  Width="200" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,15,4">
                        <TextBlock Text="{DynamicResource Str_ProjName}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtProjectName" Text="{Binding ProjectNameInput, UpdateSourceTrigger=PropertyChanged}" LostFocus="TxtProjectName_LostFocus" Width="180" Height="24" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding UpdateCurrentProjectNameCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <!-- Если флаг ошибки равен True, красим рамку в красный -->
                                        <DataTrigger Binding="{Binding IsProjectNameInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <Button Content="{DynamicResource Str_CreateProj}" Command="{Binding CreateNewProjectCommand}" Margin="0,4,15,4" Height="26"/>
                    <CheckBox IsChecked="{Binding IsAutoSaveEnabled}" Content="{DynamicResource Str_Autosave}" Margin="0,4,15,4"/>
                    <CheckBox IsChecked="{Binding IsDarkTheme}" Content="{DynamicResource Str_DarkTheme}" Margin="10,4,15,4"/>
                    <!-- НОВЫЙ ЧЕКБОКС УПРАВЛЕНИЯ СТРУКТУРОЙ -->
                    <CheckBox IsChecked="{Binding IncludeDirectoryStructure}" Content="{DynamicResource Str_IncludeStructure}" Margin="10,4,15,4"/>
                </WrapPanel>

                <!-- Пути к папкам проекта -->
                <Grid Grid.Row="1" Margin="5,0,5,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_RootPath}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <Button Grid.Column="2" Content="{DynamicResource Str_Browse}" Command="{Binding BrowseRootPathCommand}" Width="75" Margin="5,0,0,0"/>
                </Grid>

                <Grid Grid.Row="2" Margin="5,0,5,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_OutputPath}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <Button Grid.Column="2" Content="{DynamicResource Str_Browse}" Command="{Binding BrowseOutputPathCommand}" Width="75" Margin="5,0,0,0"/>
                </Grid>
            </Grid>
        </Expander>
        <!-- 2. БЛОК УПРАВЛЕНИЯ МОДУЛЯМИ (Исправлено перекрытие при сужении окна) -->
        <GroupBox Header="{DynamicResource Str_ModuleManagement}" Grid.Row="1" Margin="0,0,0,15" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Левая колонка: Селектор модуля и кнопка удаления -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Средняя колонка: Ввод имени, кнопка Добавить и выбор формата -->
                    <ColumnDefinition Width="*"/>
                    <!-- Правая колонка: Кнопка глобальных фильтров -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Колонна 1: Выбор и удаление текущего модуля -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,10,0">
                    <TextBlock Text="{DynamicResource Str_SelectModule}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Modules}"
                      SelectedItem="{Binding SelectedModule}"
                      DisplayMemberPath="ModuleName"
                      Width="150" Height="26" VerticalContentAlignment="Center"
                      IsEnabled="{Binding IsModuleSelectorEnabled}"/>

                    <Button Content="" ToolTip="{DynamicResource Str_DeleteModule}"
                    Command="{Binding DeleteCurrentModuleCommand}"
                    Width="26" Height="26" Margin="5,0,0,0" Padding="0"
                    Foreground="#E53935" FontWeight="Bold"
                    IsEnabled="{Binding IsModuleSelectorEnabled}"/>
                </StackPanel>

                <!-- Колонна 2: Название (с кнопкой Добавить) и формат файла -->
                <Grid Grid.Column="1" Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Поле ввода и кнопка «Добавить модуль» сразу за ним. Используем Grid вместо StackPanel для адаптивности -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_ModuleName}" VerticalAlignment="Center" Width="105"/>
                        <TextBox Grid.Column="1" x:Name="TxtModuleName" 
         Text="{Binding ModuleNameInput, UpdateSourceTrigger=PropertyChanged}" 
         LostFocus="TxtModuleName_LostFocus" Height="24" VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding UpdateCurrentModuleNameCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <!-- Если флаг ошибки равен True, красим рамку в красный -->
                                        <DataTrigger Binding="{Binding IsModuleNameInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="{DynamicResource Str_AddModule}" 
                        Command="{Binding CreateNewModuleCommand}" 
                        Padding="10,0" Height="24" Margin="8,0,0,0" FontWeight="Bold"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,2,0,0">
                        <TextBlock Text="{DynamicResource Str_FileFormat}" VerticalAlignment="Center" Width="105" FontWeight="SemiBold"/>
                        <RadioButton Content="txt" IsChecked="{Binding IsPdfFormat, Converter={x:Static local:InverseBooleanConverter.Instance}, Mode=TwoWay}" Margin="0,0,20,0"/>
                        <RadioButton Content="pdf" IsChecked="{Binding IsPdfFormat}" />
                    </StackPanel>
                </Grid>

                <!-- Колонна 3: Кнопка глобальных фильтров -->
                <Grid Grid.Column="2" VerticalAlignment="Top" Margin="5,1,5,0">
                    <Button Content="{DynamicResource Str_GlobalFilters}" Command="{Binding OpenFiltersWindowCommand}" Padding="10,0" Height="26"/>
                </Grid>
            </Grid>
        </GroupBox>
        <!-- 3. БЛОК РАБОЧЕЙ ОБЛАСТИ (Исправленная структура колонок и строк) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Левая колонка: дерево файлов занимает 1.3 части -->
                <ColumnDefinition Width="1.3*"/>
                <!-- Разделитель колонок -->
                <ColumnDefinition Width="Auto"/>
                <!-- Правая колонка: правила занимают 2 части -->
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: Дерево файлов (Занимает Column 0) -->
            <GroupBox Header="{DynamicResource Str_FilesHeader}" Grid.Column="0" Margin="0,0,5,0">
                <TreeView ItemsSource="{Binding RootNode.Children}">
                    <TreeView.ContextMenu>
                        <ContextMenu Background="#252526" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <MenuItem Header="{DynamicResource Str_MnuIgnoreItem}"
                              Foreground="{DynamicResource TextBrush}" Background="#252526"
                              Command="{Binding Path=PlacementTarget.DataContext.AddNodeToFiltersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding Path=PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <Grid Visibility="Collapsed"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:FileSystemNode}" ItemsSource="{Binding Children}">
                            <Grid Background="Transparent">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </GroupBox>

            <!-- РАЗДЕЛИТЕЛЬ (Занимает Column 1) -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>

            <!-- ПРАВАЯ ЧАСТЬ: Внутренний Grid для двух полей правил (Занимает Column 2) -->
            <Grid Grid.Column="2" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <!-- Верхняя строка под общие правила -->
                    <RowDefinition Height="*"/>
                    <!-- Разделитель строк (опционально, для изменения высоты полей мышкой) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Нижняя строка под правила модуля -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поле 1: Общие правила проекта (Строка 0) -->
                <GroupBox Header="{DynamicResource Str_PromptHeader}" Grid.Row="0" Margin="0,0,0,5">
                    <TextBox Text="{Binding PromptRules, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                </GroupBox>

                <!-- Дополнительный сплиттер между правилами, чтобы можно было регулировать их высоту (Строка 1) -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" Margin="0,2"/>

                <!-- Поле 2: Правила конкретного модуля (Строка 2) -->
                <GroupBox Header="{DynamicResource Str_ModulePromptHeader}" Grid.Row="2" Margin="0,5,0,0">
                    <TextBox Text="{Binding ModuleRules, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                </GroupBox>
            </Grid>
        </Grid>


        <!-- 4. БЛОК НИЖНИХ КНОПОК (ИСПРАВЛЕНО: Убран Style={x:Null}, мешавший обработке Hover) -->
        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Сохраняем индивидуальные цвета кнопок, но убираем x:Null, чтобы системный триггер шаблона работал корректно -->
            <Button Content="{DynamicResource Str_SaveProject}" Command="{Binding SaveProjectCommand}" Grid.Column="0" Height="48" Margin="0,0,5,0" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="13"/>
            <Button Content="{DynamicResource Str_Generate}" Command="{Binding GenerateContextCommand}" Grid.Column="1" Height="48" Margin="5,0,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="13"/>
        </Grid>

        <!-- ОВЕРЛЕЙ ПРОГРЕССА -->
        <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="ProgressOverlay"
              Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Background="#A0000000"/>
            <Border Width="500" Height="180" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource ControlBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding ProgressText}" Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding CurrentFileText}" Grid.Row="1" FontSize="11" Margin="0,0,0,15" Foreground="#A0A0A0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <ProgressBar Grid.Row="2" Height="16" VerticalAlignment="Top"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Background="{DynamicResource TextBoxBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                    <Button Content="{DynamicResource Str_Cancel}" Grid.Row="3"
                            Command="{Binding CancelGenerationCommand}" Height="32" Width="180" Style="{x:Null}"
                            Background="#D32F2F" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



