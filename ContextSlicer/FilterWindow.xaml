<Window x:Class="ContextSlicer.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContextSlicer"
        mc:Ignorable="d"
         Title="Глобальные фильтры исключений" 
        Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/ContentSlicer.ico">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="mainBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Border x:Name="hoverOverlay" Background="Transparent" CornerRadius="2"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="hoverOverlay" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hoverOverlay" Property="Background" Value="#30000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стилизация списков ListBox под тему оформления -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <!-- Разделитель -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: ИСКЛЮЧАЕМЫЕ ПАПКИ -->
        <GroupBox Header="Игнорируемые папки (каталоги)" Grid.Column="0" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding ExcludedFolders}" SelectedItem="{Binding SelectedFolder}" Grid.Row="0" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewFolderInput, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="24" VerticalContentAlignment="Center" Margin="0,0,5,0" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBrush}"/>
                    <Button Content="＋" Command="{Binding AddFolderCommand}" Grid.Column="1" Width="26" Padding="0" FontWeight="Bold" Margin="0,0,5,0" Foreground="#007ACC"/>
                    <Button Content="🗑" Command="{Binding DeleteFolderCommand}" Grid.Column="2" Width="26" Padding="0" Foreground="#E53935" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ПРАВАЯ КОЛОНКА: ИСКЛЮЧАЕМЫЕ РАСШИРЕНИЯ -->
        <GroupBox Header="Игнорируемые расширения файлов" Grid.Column="2" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding ExcludedExtensions}" SelectedItem="{Binding SelectedExtension}" Grid.Row="0" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewExtensionInput, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="24" VerticalContentAlignment="Center" Margin="0,0,5,0" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBrush}"/>
                    <Button Content="＋" Command="{Binding AddExtensionCommand}" Grid.Column="1" Width="26" Padding="0" FontWeight="Bold" Margin="0,0,5,0" Foreground="#007ACC"/>
                    <Button Content="🗑" Command="{Binding DeleteExtensionCommand}" Grid.Column="2" Width="26" Padding="0" Foreground="#E53935" FontWeight="Bold"/>
                    
                </Grid>
            </Grid>
        </GroupBox>

        <!-- КНОПКА ЗАКРЫТИЯ ОКНА -->
        <Button Content="ЗАКРЫТЬ НАСТРОЙКИ" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="36" 
                Click="CloseButton_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Style="{x:Null}"/>
    </Grid>
</Window>
