<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Цветовая палитра тёмной темы -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#434346"/>
    <!-- Синхронизация псевдонимов кистей для нового интерфейса (Темная тема) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2D2D30"/>

    <!-- Новые адаптивные цвета для контуров кнопок управления (ОК) -->
    <SolidColorBrush x:Key="ButtonEditBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="ButtonSyncBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ButtonDeleteBrush" Color="#E53935"/>

    <!-- Принудительные стили для ВСЕХ элементов на форме в тёмной теме -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#DCDCDC"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="#F1F1F1"/>
        <Setter Property="BorderBrush" Value="#3E3E42"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#DCDCDC"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3,2"/>
        <Setter Property="CaretBrush" Value="#F1F1F1"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- Стилизация ComboBox, чтобы текст внутри него и в выпадающем списке был белым -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Принудительно красим обычные кнопки "Обзор" и "Создать", чтобы они не оставались серыми -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="Foreground" Value="#F1F1F1"/>
        <Setter Property="BorderBrush" Value="#434346"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <!-- Стили элементов управления для Темной Темы -->
    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#252526"/>
        <Setter Property="Foreground" Value="#F1F1F1"/>
    </Style>

    <Style x:Key="ThemeProjectEditButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#007ACC"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="ThemeProjectSyncButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#4CAF50"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="ThemeModuleDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#E53935"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
  

</ResourceDictionary>