<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Базовые кисти для светлой темы -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
    <!-- Синхронизация псевдонимов кистей для нового интерфейса (Светлая тема) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>

    <!-- Адаптивные контрастные цвета для контуров кнопок (Светлая тема) -->
    <SolidColorBrush x:Key="ButtonEditBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="ButtonSyncBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="ButtonDeleteBrush" Color="#E53935"/>


    <!-- Неявные стили для сброса на стандартные цвета -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#333333"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#333333"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
    </Style>
    <!-- Стили элементов управления для Светлой Темы -->
    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1E1E1E"/>
    </Style>

    <Style x:Key="ThemeProjectEditButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#005A9E"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="ThemeProjectSyncButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#2E7D32"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="ThemeModuleDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#C62828"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
   

</ResourceDictionary>