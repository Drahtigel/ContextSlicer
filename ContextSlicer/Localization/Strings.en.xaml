<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Заголовки блоков -->
    <system:String x:Key="Str_ProjManagement">1. Project Management</system:String>
    <system:String x:Key="Str_ModuleManagement">2. Slicing Modules / AI Contexts</system:String>
    <system:String x:Key="Str_FilesHeader">Current Module Files</system:String>
    <!-- Разделенные заголовки правил prompt -->
    <system:String x:Key="Str_PromptHeader">Project General Rules (Prompt)</system:String>
    <system:String x:Key="Str_ModulePromptHeader">Current Module Rules (Prompt)</system:String>
    
    <!-- Элементы блока проекта -->
    <system:String x:Key="Str_SelectProj">Select Project:</system:String>
    <system:String x:Key="Str_ProjName">Project Name:</system:String>
    <system:String x:Key="Str_CreateProj">Create Project</system:String>
    <system:String x:Key="Str_Autosave">Autosave on exit</system:String>
    <system:String x:Key="Str_DarkTheme">Dark theme</system:String>
    <system:String x:Key="Str_RootPath">Root folder (code):</system:String>
    <system:String x:Key="Str_OutputPath">Output folder (contexts):</system:String>
    <system:String x:Key="Str_Browse">Browse...</system:String>
    <system:String x:Key="Str_IncludeStructure">Include directory structure</system:String>

    <!-- Элементы блока модулей -->
    <system:String x:Key="Str_SelectModule">Select Module:</system:String>
    <system:String x:Key="Str_ModuleName">Module Name:</system:String>
    <system:String x:Key="Str_AddModule">Add Module</system:String>
    <system:String x:Key="Str_FileFormat">File Format:</system:String>

    <!-- Главные кнопки -->
    <system:String x:Key="Str_SaveProject">SAVE PROJECT CHANGES</system:String>
    <system:String x:Key="Str_Generate">GENERATE MODULE CONTEXT FILE</system:String>

    <!-- Оверлей прогресса -->
    <system:String x:Key="Str_Cancel">CANCEL OPERATION</system:String>

    <!-- Фолбэк для заголовка экспандера -->
    <system:String x:Key="Str_ProjNotSelected">Project not selected</system:String>
    <system:String x:Key="Str_AppTitle">Code Context Slicer for AI</system:String>
    <system:String x:Key="Str_DeleteModule">Delete Module</system:String>
    <system:String x:Key="Str_GlobalFilters">Global Filters</system:String>
    <system:String x:Key="Str_MnuIgnoreItem">Add to exclusion filter</system:String>
    <!-- Расчёт токенов-->
    <system:String x:Key="Str_StatsChars">Total characters:</system:String>
    <system:String x:Key="Str_StatsTokens">Estimated tokens:</system:String>
    <system:String x:Key="Str_Calculating">Calculating size...</system:String>
    <!-- Syntax tree element prefixes -->
    <system:String x:Key="Str_Type_Namespace">[NAMESPACE]</system:String>
    <system:String x:Key="Str_Type_Class">[CLASS]</system:String>
    <system:String x:Key="Str_Type_Struct">[STRUCT]</system:String>
    <system:String x:Key="Str_Type_Interface">[INTERFACE]</system:String>
    <system:String x:Key="Str_Type_Enum">[ENUM]</system:String>
    <system:String x:Key="Str_Type_Function">[METHOD]</system:String>
    <system:String x:Key="Str_Type_Section">[SECTION]</system:String>
    <system:String x:Key="Str_LoadingStub">Loading structure...</system:String>
    <!-- Specific SQL prefixes -->
    <system:String x:Key="Str_Type_SqlTable">[TABLE]</system:String>
    <system:String x:Key="Str_Type_SqlView">[VIEW]</system:String>
    <system:String x:Key="Str_Type_SqlFunction">[SQL FUNCTION]</system:String>

    <!-- Module rename block (Overlay) -->
    <system:String x:Key="Str_ModuleNameLabel">Module Name:</system:String>
    <system:String x:Key="Str_RenameTitle">Rename Module</system:String>
    <system:String x:Key="Str_BtnCancel">Cancel</system:String>
    <system:String x:Key="Str_BtnAccept">Accept</system:String>
    <system:String x:Key="Str_TooltipRename">Rename module</system:String>
    <!-- Tooltips for project and module control buttons -->
    <system:String x:Key="Str_TooltipProjectEdit">Project settings</system:String>
    <system:String x:Key="Str_TooltipProjectSync">Synchronize / Reread source</system:String>
    <system:String x:Key="Str_TooltipModuleAdd">Add new module</system:String>
    <system:String x:Key="Str_TooltipModuleEdit">Rename current module</system:String>
    <system:String x:Key="Str_TooltipModuleDelete">Delete current module</system:String>
    <!-- Localization of text document nodes -->
    <system:String x:Key="Str_TextPart">PART</system:String>
    <system:String x:Key="Str_TextPage">Page</system:String>
    <!-- Shortened prefixes for literary text -->
    <system:String x:Key="Str_Type_Tab">[TAB]</system:String>
    <system:String x:Key="Str_Type_Heading">[CH]</system:String>

    <system:String x:Key="Str_SourceDataLabel">Data Source:</system:String>
    <!-- Network cloud interaction errors -->
    <system:String x:Key="Str_Err_GoogleDocUnavailable">Google Document is unavailable! Please check the link access, API key validity, and your network connection.</system:String>
    <system:String x:Key="Str_Err_NetworkTitle">Network Error</system:String>
    <!-- Google Service Accounts Manager Localization -->
    <system:String x:Key="Str_Err_InvalidServiceAccount">The selected file is not a valid Google Service Account key!</system:String>
    <system:String x:Key="Str_Err_ValidationTitle">Validation Error</system:String>
    <system:String x:Key="Str_Err_ImportFailed">Failed to read or import the key:</system:String>
    <system:String x:Key="Str_Err_ImportTitle">Import Error</system:String>
    <system:String x:Key="Str_Msg_EmailCopied">The service account email has been successfully copied to the clipboard:&#x0a;&#x0a;{0}&#x0a;&#x0a;Paste it into the access settings of your Google Document!</system:String>
    <system:String x:Key="Str_Msg_EmailCopiedTitle">Success</system:String>
    <system:String x:Key="Str_Err_ExtractEmailFailed">Failed to extract Email:</system:String>
    <system:String x:Key="Str_Err_GeneralErrorTitle">Error</system:String>
    <!-- System key dialog parameters -->
    <system:String x:Key="Str_Dialog_JsonFilter">Google API Key (*.json)|*.json|All Files (*.*)|*.*</system:String>
    <system:String x:Key="Str_Dialog_JsonTitle">Select the downloaded service account JSON key file</system:String>
    <system:String x:Key="Str_TextLabel">Text</system:String>
    <!-- Project update overlay statuses -->
    <system:String x:Key="Str_Update_ReadDir">Analyzing directory structure...</system:String>
    <system:String x:Key="Str_Update_GoogleApi">Synchronizing with Google Drive...</system:String>
    <system:String x:Key="Str_Update_ConvertDocx">Converting documents...</system:String>

    <!-- Error messages -->
    <system:String x:Key="Str_Err_Update_ReadDir">File access error. Make sure the storage media or local drive is connected.</system:String>
    <system:String x:Key="Str_Err_Update_Network">Network failure. Please check your internet connection.</system:String>
    <system:String x:Key="Str_Err_Update_Convert">Failed to convert file. The archive might be corrupted.</system:String>
    <system:String x:Key="Str_Update_BtnRetry">Retry</system:String>
    <system:String x:Key="Str_Update_BtnCancel">Cancel</system:String>
    <system:String x:Key="Str_Update_Title">Project Update</system:String>
    <!-- NEW STRINGS FOR ELIMINATING HARDCODE -->
    <system:String x:Key="Str_Update_LoadingGoogleDoc">Loading Google Document structure...</system:String>
    <system:String x:Key="Str_Update_BuildingTree">Building syntax tree...</system:String>
    <system:String x:Key="Str_Err_GoogleAuthFailed">Google authentication failed: Check the service account key file.</system:String>
    <system:String x:Key="Str_Err_GoogleParseError">Failed to parse Google Document structure. Invalid JSON.</system:String>
    <system:String x:Key="Str_Status_ProjectSaved">Project settings saved successfully.</system:String>
    <!-- Project Context Menu Items -->
    <system:String x:Key="Str_Mnu_UpdateProject">Update Structure</system:String>
    <system:String x:Key="Str_Mnu_DeleteProject">Delete Project</system:String>
    <system:String x:Key="Str_Mnu_RecreateGoogleDoc">Clear and Recreate Project</system:String>

    <!-- Confirmation messages -->
    <system:String x:Key="Str_Msg_ConfirmDeleteProj">Are you sure you want to completely delete project "{0}" and all its modules?</system:String>
    <system:String x:Key="Str_Msg_ConfirmRecreateGoogle">Warning! This action will completely delete the local cache, clear the tree, and force re-download the document. Continue?</system:String>
    <system:String x:Key="Str_Title_Confirmation">Confirmation Required</system:String>

</ResourceDictionary>